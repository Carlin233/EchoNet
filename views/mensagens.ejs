<!DOCTYPE html>
<html lang="pt-br" class="cosmos-active">
<head>
  <meta charset="UTF-8">
  <title>Mensagens • Nósverso</title>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#050917">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/stories-notifications.css"><link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/sidebar.css" />
  <link rel="stylesheet" href="/css/chat.css" />
  <link rel="stylesheet" href="/css/modal.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/functions.css" />
  <link rel="stylesheet" href="/css/mobile-optimizations.css" />
  <link rel="stylesheet" href="/css/echonet-enhancements.css?v=20261120" />
  <link rel="stylesheet" href="/css/echonet-modern.css?v=20261120-2" />
  <!-- EchoNet PWA -->
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/img/pwa/icon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/pwa/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="EchoNet">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="stylesheet" href="/css/echonet-pwa.css?v=1">
  <link rel="stylesheet" href="/css/echonet-app-v2.css?v=2">
  <link rel="stylesheet" href="/css/echonet-mobile-fix.css?v=20261120-1">
  
  
  
  
  
  
  
  <!-- NOSVERSO-ORBITAL:css -->
  <link rel="stylesheet" href="/css/nosverso-orbital.css?v=20261121-3">
  <!-- NOSVERSO-ORBITAL:icons -->
  <link rel="icon" type="image/png" href="/img/nosverso-orbital/icon-192.png">
  <link rel="apple-touch-icon" href="/img/nosverso-orbital/icon-192.png">
  <!-- NOSVERSO-COSMIC-MOTION:css -->
  <link rel="stylesheet" href="/css/nosverso-cosmic-motion.css?v=20261122-2">
  <!-- NOSVERSO-SINAIS-FIX:CSS -->
  <link rel="stylesheet" href="/css/nosverso-chat-reparado.css?v=20261122-2">
  <!-- NOSVERSO-CHAT-IOS-V3:CSS -->
  <link rel="stylesheet" href="/css/nosverso-chat-iphone-v3.css?v=20261122-3">
  <!-- NOSVERSO-SINAIS-2:CSS -->
  <link rel="stylesheet" href="/css/nosverso-sinais-2.css?v=2.0">
  <!-- NOSVERSO-SINAIS-2-1:CORRECAO -->
  <link rel="stylesheet" href="/css/nosverso-sinais-2-1-fix.css?v=2.1.1">
  <!-- NOSVERSO-SINAIS-2-2:CSS -->
  <link rel="stylesheet" href="/css/nosverso-sinais-2-2.css?v=2.2.0">
</head>
<body class="app-layout chat-layout <%= destinatario ? 'chat-conversation' : 'chat-list' %>">
  <%- include('partials/sidebar') %>

  <% if (destinatario) { %>
  <header class="mobile-header mobile-header-chat">
    <a href="/mensagens" class="mobile-header-back" aria-label="Voltar">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </a>
    <img src="<%= destinatarioAvatar %>" alt="" class="chat-header-avatar"><span class="mobile-header-title"><%= destinatario %></span><button type="button" class="chat-notifications notification-trigger" aria-label="Abrir notificações" aria-haspopup="dialog" aria-expanded="false"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg><span class="notification-badge" hidden>0</span></button>
  </header>
  <% } else { %>
  <%- include('partials/mobile-header') %>
  <% } %>

  <div class="app-content">
    <div class="lista-contatos" id="listaContatos">
      <div class="chat-contact-title"><span class="eyebrow">CONVERSE E CONECTE</span><h3>Mensagens</h3><p>Suas conversas em um só lugar.</p></div>
      <ul>
        <% if (contatos.length === 0) { %>
          <li class="chat-list-empty">
            Nenhuma conversa ainda.<br>
            <span>Visite o feed e converse com alguém online!</span>
          </li>
        <% } else { %>
          <% contatos.forEach(c => {
            const nome = c.contato;
            const isActive = destinatario === nome;
          %>
          <li>
            <a href="/mensagens/<%= encodeURIComponent(nome) %>" class="<%= isActive ? 'active' : '' %>">
              <img src="<%= c.avatar || '/img/default-avatar.svg' %>" alt="Foto de perfil de <%= nome %>">
              <div class="contato-info">
                <span class="nome"><%= nome %></span>
                <span class="preview">Toque para abrir a conversa</span>
              </div>
            </a>
          </li>
          <% }); %>
        <% } %>
      </ul>
    </div>

    <% if (destinatario) { %>
      <div class="mensagem-container">
        <div class="mensagem-topo mensagem-topo-desktop">
          <img src="<%= destinatarioAvatar %>" alt="Foto de perfil de <%= destinatario %>">
          <div class="chat-top-copy"><span><%= destinatario %></span><small>Conversa privada</small></div>
        </div>

        <div class="chat-box" id="chatBox">
          <% if (mensagens.length === 0) { %>
            <p class="chat-empty">Nenhuma mensagem ainda. Diga olá! 👋</p>
          <% } else { %>
            <% mensagens.forEach(m => { %>
              <div class="msg <%= m.remetente === usuarioLogado ? 'eu' : 'outro' %>"
                   data-time="<%= new Date(m.enviado_em).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %>">
                <%= m.conteudo %>
              </div>
            <% }) %>
          <% } %>
        </div>

        <!-- NOSVERSO-SINAIS-2:REPLY -->
        <div class="sinais-typing" id="sinaisTyping" role="status" aria-live="polite" hidden></div>
        <div class="sinais-reply-bar" id="sinaisReplyBar" hidden>
          <div class="sinais-reply-label"><strong>Respondendo à mensagem</strong><span id="sinaisReplyText"></span></div>
          <button type="button" id="sinaisCancelReply" aria-label="Cancelar resposta">✕</button>
        </div>
        <!-- NOSVERSO-SINAIS-2-2:COMPOSER -->
        <div class="sinais22-panel" id="sinais22Preview" hidden><div class="sinais22-preview-content"><span id="sinais22PreviewText"></span><div id="sinais22PreviewMedia"></div></div><button type="button" id="sinais22CancelFile" aria-label="Remover anexo">Remover</button></div>
        <div class="sinais22-panel" id="sinais22Status" role="status" aria-live="polite" hidden></div>
        <form id="formMensagem" class="form-mensagem">
          <input type="hidden" name="destinatario" value="<%= destinatario %>">
          <div class="sinais22-tools">
            <button type="button" id="sinais22Attach" class="sinais22-tool" aria-label="Anexar foto ou vídeo" title="Anexar foto ou vídeo">📎</button>
            <button type="button" id="sinais22Record" class="sinais22-tool" aria-label="Gravar áudio" title="Gravar áudio" aria-pressed="false">🎙️</button>
            <input type="file" id="sinais22File" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime" hidden>
          </div>
          <input type="text" name="conteudo" placeholder="Mensagem..." maxlength="2000" autocomplete="off">
          <button type="submit" aria-label="Enviar">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7.5 20-4.5-8-8-4.5L22 2Z"/><path d="M22 2 10 14"/></svg>
          </button>
        </form>
      </div>
    <% } else { %>
      <div class="mensagem-container mensagem-container-placeholder">
        <div class="chat-box">
          <p class="chat-empty">
            <i class="fa-regular fa-paper-plane"></i>
            Suas mensagens<br>
            <span>Envie mensagens privadas para seus amigos.</span>
          </p>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('partials/modal-post') %>
  <%- include('partials/notifications') %>

  <script src="/js/common.js" defer></script><script src="/js/notifications.js?v=20261120" defer></script>
  <!-- NOSVERSO-SINAIS-2:JS -->
  <!-- NOSVERSO-SINAIS-2-2:JS -->
  <script src="/js/nosverso-sinais-2-2.js?v=2.2.0" defer></script>
  <script src="/js/echonet-pwa.js?v=1" defer></script>
  <script src="/js/echonet-app-v2.js?v=20261120-3" defer></script>
  
  
  
  <!-- NOSVERSO-ORBITAL:js -->
  <script src="/js/nosverso-orbital.js?v=20261121-3" defer></script>
  <!-- NOSVERSO-COSMIC-MOTION:js -->
  <script src="/js/nosverso-cosmic-motion.js?v=20261122-2" defer></script>
  <!-- NOSVERSO-CHAT-IOS-V3:JS -->
  <script src="/js/nosverso-chat-iphone-v3.js?v=20261122-3" defer></script>
</body>
</html>
