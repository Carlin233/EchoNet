<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Mensagens • EchoNet</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/sidebar.css" />
  <link rel="stylesheet" href="/css/chat.css" />
  <link rel="stylesheet" href="/css/modal.css" />
</head>
<body class="app-layout chat-layout">
  <%- include('partials/sidebar') %>

  <div class="app-content">
    <div class="lista-contatos" id="listaContatos">
      <h3><%= usuarioLogado %></h3>
      <ul>
        <% if (contatos.length === 0) { %>
          <li style="color: var(--text-muted); font-size: 14px; padding: 12px 24px;">
            Nenhuma conversa ainda. Inicie pelo feed!
          </li>
        <% } else { %>
          <% contatos.forEach(c => {
            const nome = c.contato;
            const isActive = destinatario === nome;
          %>
          <li>
            <a href="/mensagens/<%= encodeURIComponent(nome) %>" class="<%= isActive ? 'active' : '' %>">
              <img src="/img/default-avatar.svg" alt="Avatar">
              <div class="contato-info">
                <span class="nome"><%= nome %></span>
                <span class="preview">Mensagem...</span>
              </div>
            </a>
          </li>
          <% }); %>
        <% } %>
      </ul>
    </div>

    <% if (destinatario) { %>
      <div class="mensagem-container">
        <div class="mensagem-topo">
          <img src="/img/default-avatar.svg" alt="avatar">
          <span><%= destinatario %></span>
        </div>

        <div class="chat-box" id="chatBox">
          <% if (mensagens.length === 0) { %>
            <p class="chat-empty">Nenhuma mensagem ainda. Diga olá! 👋</p>
          <% } else { %>
            <% mensagens.forEach(m => { %>
              <div class="msg <%= m.remetente === usuarioLogado ? 'eu' : 'outro' %>"
                   data-time="<%= new Date(m.enviado_em).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %>">
                <%= m.conteudo %>
              </div>
            <% }) %>
          <% } %>
        </div>

        <form id="formMensagem" class="form-mensagem">
          <input type="hidden" name="destinatario" value="<%= destinatario %>">
          <input type="text" name="conteudo" placeholder="Mensagem..." required autocomplete="off">
          <button type="submit">Enviar</button>
        </form>
      </div>
    <% } else { %>
      <div class="mensagem-container">
        <div class="mensagem-topo">
          <i class="fa-regular fa-paper-plane" style="font-size:20px;"></i>
          <span>Suas mensagens</span>
        </div>
        <div class="chat-box">
          <p class="chat-empty">
            <i class="fa-regular fa-paper-plane" style="font-size:48px;display:block;margin-bottom:16px;"></i>
            Suas mensagens<br>
            <span style="font-size:14px;color:var(--text-muted);margin-top:8px;display:block;">
              Envie fotos e mensagens privadas para um amigo.
            </span>
          </p>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('partials/modal-post') %>

  <script>
    const chatBox = document.getElementById("chatBox");
    const form = document.getElementById("formMensagem");

    if (chatBox && form) {
      const destinatario = "<%= destinatario %>";

      function scrollParaFim() {
        chatBox.scrollTop = chatBox.scrollHeight;
      }

      async function carregarMensagens() {
        const res = await fetch("/mensagens/" + encodeURIComponent(destinatario), { credentials: "include" });
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, "text/html");
        const novoChat = doc.getElementById("chatBox");
        if (novoChat) {
          chatBox.innerHTML = novoChat.innerHTML;
          scrollParaFim();
        }
      }

      form.addEventListener("submit", async e => {
        e.preventDefault();
        const conteudo = form.querySelector("input[name='conteudo']").value.trim();
        if (!conteudo) return;

        await fetch("/mensagens", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ destinatario, conteudo }),
          credentials: "include"
        });

        form.reset();
        await carregarMensagens();
      });

      scrollParaFim();
      setInterval(carregarMensagens, 5000);
    }
  </script>
</body>
</html>
