<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <title>EchoNet</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/sidebar.css" />
  <link rel="stylesheet" href="/css/feed.css" />
  <link rel="stylesheet" href="/css/modal.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
</head>
<body class="app-layout">
  <%- include('partials/sidebar') %>

  <div class="app-content">
    <main class="main-feed">
      <div class="feed">

        <!-- Stories -->
        <div class="stories-bar">
          <div class="stories-scroll">
            <a href="#" class="story-item story-add" id="abrirModalStory">
              <div class="story-ring">
                <img src="/img/default-avatar.svg" alt="" />
              </div>
              <span class="story-name">Seu story</span>
            </a>
            <% if (posts.length > 0) {
              const usuariosUnicos = [...new Set(posts.map(p => p.usuario))].slice(0, 8);
              usuariosUnicos.forEach((usuario, i) => { %>
            <div class="story-item">
              <div class="story-ring <%= i > 3 ? 'seen' : '' %>">
                <img src="/img/default-avatar.svg" alt="<%= usuario %>" />
              </div>
              <span class="story-name"><%= usuario %></span>
            </div>
            <% }); } %>
          </div>
        </div>

        <% if (posts.length === 0) { %>
          <div class="feed-empty">
            <i class="fa-regular fa-images"></i>
            <p>Nenhuma publicação ainda.</p>
            <p style="margin-top:8px;font-size:14px;">Siga pessoas para ver as fotos e vídeos delas.</p>
          </div>
        <% } else { %>
          <% posts.forEach(post => { %>
            <article class="post-card" data-post-id="<%= post.id %>">
              <div class="post-header">
                <img src="/img/default-avatar.svg" alt="" class="post-avatar" />
                <div class="author"><%= post.usuario %></div>
                <button type="button" class="post-more" title="Mais opções">
                  <i class="fa-solid fa-ellipsis"></i>
                </button>
              </div>
              <% if (post.imagem) { %>
                <div class="post-image">
                  <img src="<%= post.imagem %>" alt="Postagem" loading="lazy" />
                </div>
              <% } %>
              <div class="post-footer">
                <div class="post-actions">
                  <button type="button" class="btn-like" title="Curtir">
                    <i class="fa-regular fa-heart"></i>
                  </button>
                  <button type="button" title="Comentar">
                    <i class="fa-regular fa-comment"></i>
                  </button>
                  <button type="button" title="Compartilhar">
                    <i class="fa-regular fa-paper-plane"></i>
                  </button>
                  <button type="button" class="action-save" title="Salvar">
                    <i class="fa-regular fa-bookmark"></i>
                  </button>
                </div>
                <div class="post-likes"><span class="like-count">0</span> curtidas</div>
                <div class="caption">
                  <span class="author-name"><%= post.usuario %></span><%= post.legenda %>
                </div>
                <div class="post-comments-link">Ver todos os comentários</div>
                <div class="post-time"><%= new Date(post.criado_em).toLocaleDateString('pt-BR', {day:'numeric', month:'short'}) %></div>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>
    </main>

    <aside class="barra-online">
      <div class="suggestions-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
          <span style="font-size:14px;font-weight:600;color:var(--text-secondary);"><%= username %></span>
          <a href="/logout" style="font-size:12px;font-weight:600;color:var(--text-primary);text-decoration:none;">Sair</a>
        </div>
        <div class="user-row">
          <img src="/img/default-avatar.svg" alt="" />
          <div class="user-info">
            <div class="name"><%= username %></div>
            <div class="sub">Sua conta</div>
          </div>
        </div>
      </div>

      <h3>Sugestões para você</h3>
      <ul id="usuariosOnline"></ul>
    </aside>
  </div>

  <%- include('partials/modal-post') %>

  <script>
    document.getElementById("abrirModalStory")?.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById("abrirModal")?.click();
    });

    document.querySelectorAll(".btn-like").forEach(btn => {
      const card = btn.closest(".post-card");
      const postId = card.dataset.postId;
      const countEl = card.querySelector(".like-count");
      const key = "like_" + postId;

      if (localStorage.getItem(key)) {
        btn.classList.add("liked");
        btn.querySelector("i").className = "fa-solid fa-heart";
        countEl.textContent = localStorage.getItem(key + "_count") || "1";
      }

      btn.addEventListener("click", () => {
        const icon = btn.querySelector("i");
        if (btn.classList.contains("liked")) {
          btn.classList.remove("liked");
          icon.className = "fa-regular fa-heart";
          countEl.textContent = "0";
          localStorage.removeItem(key);
          localStorage.removeItem(key + "_count");
        } else {
          btn.classList.add("liked");
          icon.className = "fa-solid fa-heart";
          countEl.textContent = "1";
          localStorage.setItem(key, "1");
          localStorage.setItem(key + "_count", "1");
        }
      });
    });

    setInterval(() => {
      fetch("/atualizar-ativo", { method: "POST", credentials: "include" });
    }, 30000);

    function carregarUsuariosOnline() {
      fetch("/online-users", { credentials: "include" })
        .then(res => res.json())
        .then(lista => {
          const ul = document.getElementById("usuariosOnline");
          ul.innerHTML = "";
          if (lista.length === 0) {
            ul.innerHTML = '<li style="color:var(--text-muted);font-size:13px;padding:8px 0;">Nenhuma sugestão no momento</li>';
            return;
          }
          lista.slice(0, 5).forEach(usuario => {
            const li = document.createElement("li");
            li.innerHTML = `
              <div class="user-row" style="margin-bottom:12px;">
                <a href="/mensagens/${encodeURIComponent(usuario.username)}" style="display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit;flex:1;">
                  <img src="/img/default-avatar.svg" alt="" style="width:32px;height:32px;border-radius:50%;" />
                  <div class="user-info">
                    <div class="name" style="font-size:14px;">${usuario.username}</div>
                    <div class="sub"><span class="dot-status ${usuario.status}"></span> ${usuario.status === 'online' ? 'Online' : usuario.status === 'away' ? 'Ausente' : 'Offline'}</div>
                  </div>
                </a>
                <button class="follow-btn">Seguir</button>
              </div>`;
            ul.appendChild(li);
          });
        });
    }

    setInterval(carregarUsuariosOnline, 10000);
    carregarUsuariosOnline();
  </script>
</body>
</html>
