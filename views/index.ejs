<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Feed • EchoNet</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/stories-notifications.css" /><link rel="stylesheet" href="/css/global.css" /><link rel="stylesheet" href="/css/sidebar.css" /><link rel="stylesheet" href="/css/feed.css" /><link rel="stylesheet" href="/css/modal.css" /><link rel="stylesheet" href="/css/responsive.css" /><link rel="stylesheet" href="/css/functions.css" />
  <link rel="stylesheet" href="/css/mobile-optimizations.css" />
  <link rel="stylesheet" href="/css/echonet-enhancements.css?v=20261120" />
  <link rel="stylesheet" href="/css/echonet-modern.css?v=20261120-2" />
  <!-- EchoNet PWA -->
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/img/pwa/icon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/pwa/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="EchoNet">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="stylesheet" href="/css/echonet-pwa.css?v=1">
  <link rel="stylesheet" href="/css/echonet-app-v2.css?v=2">
  <link rel="stylesheet" href="/css/echonet-mobile-fix.css?v=20261120-1">
</head>
<body class="app-layout">
  <%- include('partials/sidebar') %>
  <div class="app-content">
    <%- include('partials/mobile-header') %>
    <main class="main-feed"><div class="feed">
      <header class="page-intro feed-intro"><span class="eyebrow">ECHONET SOCIAL</span><h1>Seu feed <span class="intro-accent">✨</span></h1><p>Momentos, histórias e pessoas que fazem parte do seu dia.</p></header>
      <div class="stories-bar" data-current-user="<%= username %>"><div class="stories-scroll" id="storiesList">
        <button type="button" class="story-item story-add" id="abrirModalStory" aria-label="Criar Story"><span class="story-ring"><img src="<%= myAvatar %>" alt="" /></span><span class="story-name">Seu Story +</span></button>
        <span class="stories-loading" id="storiesLoading">Carregando Stories...</span>
      </div></div>
      <% if (!posts.length) { %><div class="feed-empty"><i class="fa-regular fa-images"></i><p>Nenhuma publicação ainda.</p><p>Crie a primeira foto para começar!</p></div><% } %>
      <% posts.forEach(post => { %>
      <article class="post-card" id="post-<%= post.id %>" data-post-id="<%= post.id %>">
        <div class="post-header"><img src="<%= post.author_avatar || '/img/default-avatar.svg' %>" alt="" class="post-avatar" /><a class="author" href="/perfil/<%= encodeURIComponent(post.usuario) %>"><%= post.usuario %></a><button type="button" class="post-more" title="Copiar link da publicação" aria-label="Copiar link"><svg class="post-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1" fill="currentColor"/><circle cx="12" cy="12" r="1" fill="currentColor"/><circle cx="19" cy="12" r="1" fill="currentColor"/></svg></button></div>
        <div class="post-image"><img src="<%= post.imagem %>" alt="Publicação de <%= post.usuario %>" loading="lazy" /></div>
        <div class="post-footer">
          <div class="post-actions">
            <button type="button" class="btn-like <%= post.liked ? 'liked' : '' %>" aria-label="Curtir" aria-pressed="<%= Boolean(post.liked) %>"><svg class="post-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></button>
            <button type="button" class="btn-comment" aria-label="Comentar"><svg class="post-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4.1-1L3 21l1.7-5A8.5 8.5 0 1 1 21 11.5Z"/></svg></button>
            <button type="button" class="btn-share" aria-label="Compartilhar"><svg class="post-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7.5 20-4.5-8-8-4.5L22 2Z"/><path d="M22 2 10 14"/></svg></button>
            <button type="button" class="action-save <%= post.saved ? 'saved' : '' %>" aria-label="Salvar publicação" aria-pressed="<%= Boolean(post.saved) %>" title="<%= post.saved ? 'Remover dos salvos' : 'Salvar' %>"><svg class="post-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4V3Z"/></svg></button>
          </div>
          <div class="post-likes"><span class="like-count"><%= post.like_count %></span> curtidas</div>
          <div class="caption"><a href="/perfil/<%= encodeURIComponent(post.usuario) %>" class="author-name"><%= post.usuario %></a> <%= post.legenda %></div>
          <button type="button" class="post-comments-link">Ver comentários (<span class="comments-count"><%= post.comment_count %></span>)</button>
          <section class="comments-panel" hidden><div class="comments-list" aria-live="polite"></div><form class="comment-form"><input name="conteudo" maxlength="1000" placeholder="Adicione um comentário..." autocomplete="off" required><button type="submit">Enviar</button></form></section>
          <div class="post-time"><%= safeDate(post.criado_em) %></div>
        </div>
      </article>
      <% }) %>
    </div></main>
    <aside class="barra-online"><div class="suggestions-card"><div class="account-header"><strong><%= username %></strong><form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="text-link">Sair</button></form></div><div class="user-row"><img src="<%= myAvatar %>" alt=""><div class="user-info"><div class="name"><%= username %></div><div class="sub">Sua conta</div></div></div></div><h3>Pessoas para conhecer</h3><ul id="usuariosOnline"></ul></aside>
  </div>
  <%- include('partials/modal-post') %>
  <%- include('partials/notifications') %>
  <%- include('partials/stories') %>
  <script src="/js/common.js" defer></script><script src="/js/notifications.js?v=20261120" defer></script><script src="/js/stories.js" defer></script><script src="/js/feed.js?v=mobile-202611" defer></script>
  <script src="/js/echonet-pwa.js?v=1" defer></script>
  <script src="/js/echonet-app-v2.js?v=20261120-3" defer></script>
</body>
</html>
