<!DOCTYPE html>
<html lang="pt-BR" class="cosmos-active">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#050917">
  <title>Redefinir Senha - Nósverso</title>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="stylesheet" href="/css/login.css" />
  <link rel="stylesheet" href="/css/mobile-optimizations.css" />
  <!-- EchoNet PWA -->
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/img/pwa/icon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/pwa/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="EchoNet">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="stylesheet" href="/css/echonet-pwa.css?v=1">
  <link rel="stylesheet" href="/css/echonet-app-v2.css?v=2">
  <link rel="stylesheet" href="/css/echonet-mobile-fix.css?v=20261120-1">
  
  
  
  
  
  
  
  <!-- NOSVERSO-ORBITAL:css -->
  <link rel="stylesheet" href="/css/nosverso-orbital.css?v=20261121-3">
  <!-- NOSVERSO-ORBITAL:icons -->
  <link rel="icon" type="image/png" href="/img/nosverso-orbital/icon-192.png">
  <link rel="apple-touch-icon" href="/img/nosverso-orbital/icon-192.png">
  <!-- NOSVERSO-COSMIC-MOTION:css -->
  <link rel="stylesheet" href="/css/nosverso-cosmic-motion.css?v=20261122-2">
</head>
<body>
  <div class="reset-page">
    <div class="reset-box">
      <div class="form-logo">
        <span class="echo">Echo</span><span class="net">Net</span>
      </div>
      <h2>Redefinir senha</h2>
      <div id="resetError" class="error-message"></div>
      <div id="resetSuccess" class="success-message" style="display:none;"></div>
      <form id="resetForm">
        <input type="hidden" name="token" value="<%= token %>">
        <input type="password" name="password" placeholder="Nova senha" minlength="8" required>
        <input type="password" name="confirmPassword" placeholder="Confirmar nova senha" minlength="8" required>
        <button type="submit">Atualizar senha</button>
      </form>
    </div>
  </div>

  <script>
    document.getElementById("resetForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const errEl = document.getElementById("resetError");
      const okEl = document.getElementById("resetSuccess");
      errEl.style.display = "none";
      okEl.style.display = "none";

      const data = Object.fromEntries(new FormData(e.target).entries());

      try {
        const res = await fetch("/resetar-senha", {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (result.success) {
          okEl.textContent = result.message;
          okEl.style.display = "block";
          setTimeout(() => window.location.href = "/login.html", 2000);
        } else {
          errEl.textContent = result.message;
          errEl.style.display = "block";
        }
      } catch {
        errEl.textContent = "Erro na comunicação com o servidor.";
        errEl.style.display = "block";
      }
    });
  </script>
  <script src="/js/echonet-pwa.js?v=1" defer></script>
  <script src="/js/echonet-app-v2.js?v=20261120-3" defer></script>
  
  
  
  <!-- NOSVERSO-ORBITAL:js -->
  <script src="/js/nosverso-orbital.js?v=20261121-3" defer></script>
  <!-- NOSVERSO-COSMIC-MOTION:js -->
  <script src="/js/nosverso-cosmic-motion.js?v=20261122-2" defer></script>
</body>
</html>
