<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= username %> • EchoNet</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/stories-notifications.css"><link rel="stylesheet" href="/css/global.css"><link rel="stylesheet" href="/css/sidebar.css"><link rel="stylesheet" href="/css/perfil.css"><link rel="stylesheet" href="/css/modal.css"><link rel="stylesheet" href="/css/responsive.css"><link rel="stylesheet" href="/css/functions.css">
  <link rel="stylesheet" href="/css/mobile-optimizations.css" />
  <link rel="stylesheet" href="/css/echonet-enhancements.css?v=20261120" />
  <link rel="stylesheet" href="/css/echonet-modern.css?v=20261120-2" />
  <!-- EchoNet PWA -->
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/img/pwa/icon-192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/pwa/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="EchoNet">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="stylesheet" href="/css/echonet-pwa.css?v=1">
  <link rel="stylesheet" href="/css/echonet-app-v2.css?v=2">
  <link rel="stylesheet" href="/css/echonet-mobile-fix.css?v=20261120-1">
  <link rel="stylesheet" href="/css/echonet-criar-story-perfil.css?v=20261120-21">
  <link rel="stylesheet" href="/css/echonet-visualizador-posts.css?v=20261120-comentarios-mobile-2">
</head>
<body class="app-layout">
  <%- include('partials/sidebar') %>
  <div class="app-content">
    <%- include('partials/mobile-header') %>
    <main class="perfil-page"><div class="perfil-container">
      <div class="page-intro profile-intro"><span class="eyebrow">SEU ESPAÇO</span><h2>Perfil <span class="intro-accent">& comunidade</span></h2><p>Seu espaço para compartilhar momentos e conexões.</p></div>
      <header class="perfil-header">
        <div class="perfil-avatar-desktop"><% if (isMine) { %><button type="button" class="perfil-avatar-trigger open-edit" title="Trocar foto de perfil" aria-label="Trocar foto de perfil"><div class="perfil-avatar-ring <%= hasActiveStory ? 'has-story' : 'no-story' %>"><img src="<%= owner.avatar || '/img/default-avatar.svg' %>" alt="Foto de perfil de <%= username %>" class="perfil-avatar"></div><span class="perfil-avatar-camera"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></svg></span></button><% } else { %><div class="perfil-avatar-ring <%= hasActiveStory ? 'has-story' : 'no-story' %>"><img src="<%= owner.avatar || '/img/default-avatar.svg' %>" alt="Foto de perfil de <%= username %>" class="perfil-avatar"></div><% } %></div>
        <div class="perfil-mobile-top"><% if (isMine) { %><button type="button" class="perfil-avatar-trigger open-edit" title="Trocar foto de perfil" aria-label="Trocar foto de perfil"><div class="perfil-avatar-ring <%= hasActiveStory ? 'has-story' : 'no-story' %>"><img src="<%= owner.avatar || '/img/default-avatar.svg' %>" alt="Foto de perfil de <%= username %>" class="perfil-avatar"></div><span class="perfil-avatar-camera"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></svg></span></button><% } else { %><div class="perfil-avatar-ring <%= hasActiveStory ? 'has-story' : 'no-story' %>"><img src="<%= owner.avatar || '/img/default-avatar.svg' %>" alt="Foto de perfil de <%= username %>" class="perfil-avatar"></div><% } %><ul class="perfil-stats perfil-stats-mobile"><li><strong><%= posts.length %></strong><span>publicações</span></li><li><strong class="follower-count"><%= follows.followers %></strong><span>seguidores</span></li><li><strong><%= follows.following %></strong><span>seguindo</span></li></ul></div>
        <div class="perfil-details">
          <div class="perfil-top-row"><h1 class="perfil-username"><%= username %></h1><div class="perfil-actions perfil-actions-desktop">
            <% if (isMine) { %><button type="button" class="perfil-btn open-edit">Editar perfil</button><button type="button" class="perfil-btn open-archive">Ver arquivo</button><a class="perfil-btn perfil-btn-icon" href="/configuracoes" title="Configurações da conta" aria-label="Configurações da conta"><i class="fa-solid fa-gear"></i></a><% } else { %><button class="perfil-btn btn-follow" type="button" data-username="<%= username %>"><%= follows.isFollowing ? 'Seguindo' : 'Seguir' %></button><a class="perfil-btn" href="/mensagens/<%= encodeURIComponent(username) %>">Mensagem</a><% } %>
          </div></div>
          <ul class="perfil-stats perfil-stats-desktop"><li><strong><%= posts.length %></strong> publicações</li><li><strong class="follower-count"><%= follows.followers %></strong> seguidores</li><li><strong><%= follows.following %></strong> seguindo</li></ul>
          <div class="perfil-actions perfil-actions-mobile"><% if (isMine) { %><button class="perfil-btn open-edit" type="button">Editar perfil</button><button class="perfil-btn open-archive" type="button">Ver arquivo</button><a class="perfil-btn" href="/configuracoes"><i class="fa-solid fa-gear" aria-hidden="true"></i> Conta</a><% } else { %><button class="perfil-btn btn-follow" type="button" data-username="<%= username %>"><%= follows.isFollowing ? 'Seguindo' : 'Seguir' %></button><a class="perfil-btn" href="/mensagens/<%= encodeURIComponent(username) %>">Mensagem</a><% } %></div>
          <div class="perfil-bio"><span class="perfil-name"><%= owner.display_name || username %></span><span class="perfil-bio-text"><%= owner.bio || 'Bem-vindo ao meu perfil no EchoNet ✨' %></span></div>
        </div>
      </header>
      <% if (isMine) { %><div class="perfil-highlights"><button type="button" class="highlight-item" id="newPostButton" style="border:0;background:none;color:inherit;cursor:pointer;"><div class="highlight-ring"><div class="highlight-inner"><span aria-hidden="true" class="highlight-plus">+</span></div></div><span>Nova foto</span></button></div><% } %>
      <nav class="perfil-tabs" aria-label="Seções do perfil"><button type="button" class="perfil-tab active" data-tab="posts" aria-selected="true"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span>Publicações</span></button><% if (isMine) { %><button type="button" class="perfil-tab" data-tab="saved" aria-selected="false"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4V3Z"/></svg><span>Salvos</span></button><button type="button" class="perfil-tab" data-tab="archive" aria-selected="false"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v11h14V9M10 13h4"/></svg><span>Arquivo</span></button><% } %></nav>
      <section class="perfil-grid-panel" id="tab-posts"><% if (!posts.length) { %><div class="perfil-empty"><div class="perfil-empty-icon"><i class="fa-regular fa-image"></i></div><h3>Sem publicações</h3><p>As fotos publicadas aparecem aqui.</p><% if (isMine) { %><button type="button" class="perfil-btn perfil-btn-accent" id="abrirModalPerfil">Compartilhar primeira foto</button><% } %></div><% } else { %>
        <div class="perfil-grid"><% posts.forEach(post => { %><div class="grid-item" data-post-id="<%= post.id %>" data-caption="<%= post.legenda || '' %>" data-author="<%= post.usuario %>" data-avatar="<%= post.author_avatar || '/img/default-avatar.svg' %>" data-likes="<%= post.like_count || 0 %>" data-liked="<%= post.liked ? 'true' : 'false' %>" data-saved="<%= post.saved ? 'true' : 'false' %>"><a href="/post/<%= post.id %>"><img src="<%= post.imagem %>" alt="Publicação" loading="lazy"><div class="grid-overlay"><span><i class="fa-solid fa-heart"></i> <%= post.like_count %></span><span><i class="fa-solid fa-comment"></i> <%= post.comment_count %></span></div></a><% if (isMine) { %><div class="perfil-post-controls"><button class="btn-archive" type="button">Arquivar</button><form action="/deletar-post/<%= post.id %>" method="POST" onsubmit="return confirm('Excluir esta publicação permanentemente?')"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button type="submit">Excluir</button></form></div><% } %></div><% }); %></div><% } %></section>
      <% if (isMine) { %><section class="perfil-grid-panel" id="tab-saved" hidden><% if (!savedPosts.length) { %><p class="profile-section-empty">Você ainda não salvou publicações.</p><% } else { %><div class="perfil-grid"><% savedPosts.forEach(post => { %><div class="grid-item" data-post-id="<%= post.id %>" data-caption="<%= post.legenda || '' %>" data-author="<%= post.usuario %>" data-avatar="<%= post.author_avatar || '/img/default-avatar.svg' %>" data-likes="<%= post.like_count || 0 %>" data-liked="<%= post.liked ? 'true' : 'false' %>" data-saved="<%= post.saved ? 'true' : 'false' %>"><a href="/post/<%= post.id %>"><img src="<%= post.imagem %>" alt="Publicação de <%= post.usuario %>" loading="lazy"></a></div><% }); %></div><% } %></section>
      <section class="perfil-grid-panel" id="tab-archive" hidden><% if (!archivedPosts.length) { %><p class="profile-section-empty">Nenhuma publicação arquivada.</p><% } else { %><div class="perfil-grid"><% archivedPosts.forEach(post => { %><div class="grid-item" data-post-id="<%= post.id %>" data-caption="<%= post.legenda || '' %>" data-author="<%= post.usuario %>" data-avatar="<%= post.author_avatar || '/img/default-avatar.svg' %>" data-likes="<%= post.like_count || 0 %>" data-liked="<%= post.liked ? 'true' : 'false' %>" data-saved="<%= post.saved ? 'true' : 'false' %>"><img src="<%= post.imagem %>" alt="Publicação arquivada" loading="lazy"><div class="perfil-post-controls"><button class="btn-archive" type="button">Restaurar</button><form action="/deletar-post/<%= post.id %>" method="POST" onsubmit="return confirm('Excluir esta publicação permanentemente?')"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button type="submit">Excluir</button></form></div></div><% }); %></div><% } %></section><% } %>
      <div class="perfil-logout-mobile"><form action="/logout" method="POST"><input name="_csrf" type="hidden" value="<%= csrfToken %>"><button type="submit" class="text-link">Sair da conta</button></form></div>
    </div></main>
  </div>
  <% if (isMine) { %><div class="modal" id="editModal"><div class="profile-edit-dialog"><button type="button" class="fechar" id="closeEdit" aria-label="Fechar edição">&times;</button><h2>Editar perfil</h2>
    <section class="edit-avatar-section" aria-label="Foto de perfil">
      <img src="<%= owner.avatar || '/img/default-avatar.svg' %>" alt="Prévia da sua foto de perfil" id="avatarPreview" class="edit-avatar-preview">
      <div class="edit-avatar-fields"><strong>Sua foto</strong><span>JPG, PNG, WebP ou GIF • até 3 MB</span>
        <form id="avatarUploadForm" enctype="multipart/form-data">
          <label class="avatar-file-label" for="avatarFile"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></svg> Escolher foto</label>
          <input id="avatarFile" type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" required>
          <span id="avatarFileName" class="avatar-filename" aria-live="polite"></span>
          <button type="submit" class="avatar-upload-btn">Salvar foto</button>
        </form>
        <% if (owner.avatar) { %><button type="button" id="removeAvatar" class="avatar-remove-btn">Remover foto atual</button><% } %>
      </div>
    </section>
    <p class="profile-notice" id="avatarStatus" role="status" aria-live="polite"></p>
    <div class="edit-profile-divider"></div>
    <form id="editProfileForm"><label>Nome de exibição<input name="display_name" maxlength="60" value="<%= owner.display_name || '' %>"></label><label>Biografia<textarea name="bio" maxlength="300" rows="5"><%= owner.bio || '' %></textarea></label><p class="profile-notice" id="editStatus"></p><button type="submit">Salvar alterações</button></form></div></div><% } %>
  <%- include('partials/modal-post') %>
  <%- include('partials/notifications') %>
  <script src="/js/common.js" defer></script><script src="/js/notifications.js?v=20261120" defer></script><script src="/js/profile.js" defer></script>
  <script src="/js/echonet-pwa.js?v=1" defer></script>
  <script src="/js/echonet-app-v2.js?v=20261120-3" defer></script>
  <script src="/js/echonet-criar-story-perfil.js?v=20261120-21" defer></script>
  <script src="/js/echonet-visualizador-posts.js?v=20261120-comentarios-mobile-2" defer></script>
</body>
</html>
