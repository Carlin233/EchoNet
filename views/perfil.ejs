<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <title><%= username %> • EchoNet</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/sidebar.css" />
  <link rel="stylesheet" href="/css/perfil.css" />
  <link rel="stylesheet" href="/css/modal.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
</head>
<body class="app-layout">
  <%- include('partials/sidebar') %>

  <div class="app-content">
    <main class="perfil-page">
      <div class="perfil-container">

        <!-- Cabeçalho do perfil -->
        <header class="perfil-header">
          <div class="perfil-avatar-desktop">
            <div class="perfil-avatar-ring">
              <img src="/img/default-avatar.svg" alt="Foto de perfil de <%= username %>" class="perfil-avatar" />
            </div>
          </div>

          <div class="perfil-mobile-top">
            <div class="perfil-avatar-ring">
              <img src="/img/default-avatar.svg" alt="Foto de perfil de <%= username %>" class="perfil-avatar" />
            </div>
            <ul class="perfil-stats perfil-stats-mobile">
              <li><strong><%= posts.length %></strong><span>publicações</span></li>
              <li><button type="button" class="stat-link"><strong>0</strong><span>seguidores</span></button></li>
              <li><button type="button" class="stat-link"><strong>0</strong><span>seguindo</span></button></li>
            </ul>
          </div>

          <div class="perfil-details">
            <div class="perfil-top-row">
              <h1 class="perfil-username"><%= username %></h1>
              <div class="perfil-actions perfil-actions-desktop">
                <button class="perfil-btn" type="button">Editar perfil</button>
                <button class="perfil-btn" type="button">Ver arquivo</button>
                <button class="perfil-btn perfil-btn-icon" type="button" title="Configurações">
                  <i class="fa-solid fa-gear"></i>
                </button>
              </div>
            </div>

            <ul class="perfil-stats perfil-stats-desktop">
              <li><strong><%= posts.length %></strong> publicações</li>
              <li><button type="button" class="stat-link"><strong>0</strong> seguidores</button></li>
              <li><button type="button" class="stat-link"><strong>0</strong> seguindo</button></li>
            </ul>

            <div class="perfil-actions perfil-actions-mobile">
              <button class="perfil-btn" type="button">Editar perfil</button>
              <button class="perfil-btn" type="button">Ver arquivo</button>
              <button class="perfil-btn perfil-btn-icon" type="button" title="Configurações">
                <i class="fa-solid fa-gear"></i>
              </button>
            </div>

            <div class="perfil-bio">
              <span class="perfil-name"><%= username %></span>
              <span class="perfil-bio-text">Bem-vindo ao meu perfil no EchoNet ✨</span>
            </div>
          </div>
        </header>

        <!-- Destaques (visual) -->
        <div class="perfil-highlights">
          <div class="highlight-item">
            <div class="highlight-ring">
              <div class="highlight-inner"><i class="fa-solid fa-plus"></i></div>
            </div>
            <span>Novo</span>
          </div>
        </div>

        <!-- Abas -->
        <nav class="perfil-tabs" aria-label="Seções do perfil">
          <button type="button" class="perfil-tab active" aria-current="page">
            <i class="fa-solid fa-table-cells"></i>
            <span>Publicações</span>
          </button>
          <button type="button" class="perfil-tab">
            <i class="fa-solid fa-film"></i>
            <span>Reels</span>
          </button>
          <button type="button" class="perfil-tab">
            <i class="fa-regular fa-bookmark"></i>
            <span>Salvos</span>
          </button>
        </nav>

        <!-- Grade de posts -->
        <% if (posts.length === 0) { %>
          <div class="perfil-empty">
            <div class="perfil-empty-icon">
              <i class="fa-regular fa-image"></i>
            </div>
            <h3>Compartilhe fotos</h3>
            <p>Quando você compartilhar fotos, elas aparecerão no seu perfil.</p>
            <button type="button" class="perfil-btn perfil-btn-accent" id="abrirModalPerfil">
              Compartilhar primeira foto
            </button>
          </div>
        <% } else { %>
          <div class="perfil-grid">
            <% posts.forEach(post => { %>
              <div class="grid-item">
                <img src="<%= post.imagem %>" alt="Publicação" loading="lazy" />
                <div class="grid-overlay">
                  <span><i class="fa-solid fa-heart"></i></span>
                  <span><i class="fa-solid fa-comment"></i></span>
                </div>
                <form action="/deletar-post/<%= post.id %>" method="POST" class="delete-form"
                      onsubmit="return confirm('Deseja excluir esta publicação?')">
                  <button type="submit" class="btn-delete" title="Excluir">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>

      </div>
    </main>
  </div>

  <%- include('partials/modal-post') %>

  <script>
    document.getElementById("abrirModalPerfil")?.addEventListener("click", () => {
      document.getElementById("abrirModal")?.click();
    });
  </script>
</body>
</html>
