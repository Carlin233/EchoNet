<div id="modalCriar" class="modal">
  <div class="modal-conteudo estilizado">
    <div class="modal-header-bar">
      <h3>Criar nova publicação</h3>
      <button type="button" class="fechar" id="fecharModal">&times;</button>
    </div>
    <div class="modal-body">
      <form id="formPostagem" enctype="multipart/form-data">
        <label class="upload-area" for="uploadInput">
          <span class="upload-text"><i class="fa-regular fa-image"></i> Arraste a foto aqui<br><span style="font-size:12px;color:var(--accent);font-weight:600;">Selecionar do computador</span></span>
          <img id="previewImagem" src="" alt="Preview" class="preview" />
          <input type="file" name="imagem" id="uploadInput" accept="image/*" hidden required />
        </label>
        <textarea name="legenda" placeholder="Escreva uma legenda..." required></textarea>
        <button type="submit">Compartilhar</button>
      </form>
    </div>
  </div>
</div>

<script>
(function() {
  const modal = document.getElementById("modalCriar");
  const abrir = document.getElementById("abrirModal");
  const fechar = document.getElementById("fecharModal");
  const uploadInput = document.getElementById("uploadInput");
  const preview = document.getElementById("previewImagem");
  const form = document.getElementById("formPostagem");

  if (!modal || !abrir) return;

  abrir.onclick = (e) => {
    e.preventDefault();
    modal.style.display = "flex";
    if (preview) { preview.style.display = "none"; preview.src = ""; }
    const txt = document.querySelector(".upload-text");
    if (txt) txt.style.display = "block";
  };

  if (fechar) fechar.onclick = () => modal.style.display = "none";
  window.addEventListener("click", (e) => { if (e.target === modal) modal.style.display = "none"; });

  if (uploadInput && preview) {
    uploadInput.onchange = (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        preview.src = reader.result;
        preview.style.display = "block";
        const txt = document.querySelector(".upload-text");
        if (txt) txt.style.display = "none";
      };
      reader.readAsDataURL(file);
    };
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const res = await fetch("/postar", { method: "POST", body: data, credentials: "include" });
      if (!res.ok) { alert("Erro ao postar!"); return; }
      window.location.reload();
    });
  }
})();
</script>
