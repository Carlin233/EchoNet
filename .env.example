# Configure no seu ambiente (não publique o .env).
PORT=3000
NODE_ENV=development
SESSION_SECRET=gere-uma-chave-aleatoria-de-pelo-menos-32-caracteres
# DB_PATH=/caminho/seguro/database.sqlite
# TRUST_PROXY=1  # se estiver atrás de um proxy HTTPS confiável

# Opcional: armazenamento persistente (Render pago com Persistent Disk)
# DB_PATH=/var/data/database.sqlite
# UPLOAD_DIR=/var/data/uploads

# OPÇÃO A: plano Render pago com Persistent Disk montado em /var/data
# PERSISTENT_DATA_DIR=/var/data

# OPÇÃO B: plano Render gratuito usando banco e imagens externos
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=token-privado-gerado-pelo-Turso
# CLOUDINARY_URL=cloudinary://CHAVE_API:SEGREDO_API@NOME_NUVEM

# Avisar e impedir inicio no Render quando nenhum armazenamento foi configurado:
# REQUIRE_PERSISTENCE=1
